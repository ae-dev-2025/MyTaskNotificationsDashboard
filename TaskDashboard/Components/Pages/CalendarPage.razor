@page "/calendar"
@inject DashboardService Todos
@inject IJSRuntime JS
@implements IDisposable

<h1>Calendar</h1>
<p class="cal-subtitle">@WeekRangeText</p>

<div class="cal-toolbar">
    <div class="btn-group" role="group" aria-label="Calendar navigation">
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => Shift(-1)">@PrevLabel</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="GoToday" disabled="@IsOnToday">Today</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => Shift(1)">@NextLabel</button>
    </div>

    <div class="btn-group" role="group" aria-label="Calendar view">
        <button type="button"
                class="btn btn-sm cal-view-day @(dayCount == 1 ? "btn-secondary" : "btn-outline-secondary")"
                aria-pressed="@(dayCount == 1)"
                @onclick="() => SetView(1)">
            Day
        </button>
        <button type="button"
                class="btn btn-sm cal-view-3day @(dayCount == 3 ? "btn-secondary" : "btn-outline-secondary")"
                aria-pressed="@(dayCount == 3)"
                @onclick="() => SetView(3)">
            3 days
        </button>
        <button type="button"
                class="btn btn-sm cal-view-week @(dayCount == 7 ? "btn-secondary" : "btn-outline-secondary")"
                aria-pressed="@(dayCount == 7)"
                @onclick="() => SetView(7)">
            Week
        </button>
    </div>
</div>

@{ var week = BuildWeek(); }

<div class="cal-body">
<div class="cal-scroll" @ref="scrollArea" style="--hour-px:@(HourPx)px;--day-count:@dayCount">
    <div class="cal-header">
        <div class="cal-gutter-spacer"></div>
        @foreach (var day in week.Days)
        {
            <div class="cal-head-day @(day.IsToday ? "today" : null) @(day.IsWeekend ? "weekend" : null)">
                @day.Date.ToString("ddd d MMM")
            </div>
        }
    </div>

    <div class="cal-grid">
        <div class="cal-gutter">
            @for (var h = 0; h < 24; h++)
            {
                <div class="cal-hour-label" style="top:@(h * HourPx)px">@($"{h:00}:00")</div>
            }

            @* The current time reads in the gutter, beside the hour labels it
               belongs with. It used to be a pill on the line itself, which sat
               on top of whatever block the line crossed and covered exactly the
               row carrying that block's time, late tag and title. *@
            @if (TodayVisible)
            {
                <div class="cal-now-label" style="top:@(NowOffsetPx)px">@DateTime.Now.ToString("HH:mm")</div>
            }
        </div>

        @foreach (var day in week.Days)
        {
            <div class="cal-day @(day.IsToday ? "today" : null) @(day.IsWeekend ? "weekend" : null)">
                @foreach (var block in day.Blocks)
                {
                    <div class="@block.CssClass"
                         style="top:@(block.Top)px;height:@(block.Height)px;--title-lines:@block.TitleLines;@block.LaneStyle"
                         title="@block.Tooltip">
                        <span class="cal-block-head">
                            <span class="cal-block-time">@block.TimeText</span>
                            @if (block.Late)
                            {
                                @* Ahead of the title in source order, so a
                                   truncating title can never eat it. *@
                                <span class="cal-late">late</span>
                            }
                        </span>
                        <span class="cal-block-title">@block.Title</span>
                    </div>
                }

                @foreach (var marker in day.Markers)
                {
                    <div class="cal-deadline" style="top:@(marker.Top)px" title="@marker.Tooltip">
                        <span class="cal-deadline-chip">@marker.Title</span>
                    </div>
                }

                @if (day.IsToday)
                {
                    <div class="cal-now-line" style="top:@(NowOffsetPx)px"></div>
                }
            </div>
        }
    </div>

    @if (week.Empty)
    {
        <div class="cal-empty">Nothing scheduled in view.</div>
    }
</div>

@* Vertical zoom: taller hours give every block more room for its text.
   Outside the scroll container so it never scrolls away; on the right, so
   the hour gutter keeps the left edge. *@
<div class="cal-zoom" title="Zoom: taller hours give tasks more room">
    <span class="cal-zoom-cap" aria-hidden="true">+</span>
    <input type="range"
           class="cal-zoom-slider"
           min="@MinHourPx" max="@MaxHourPx" step="8"
           value="@HourPx"
           aria-label="Zoom calendar"
           @oninput="OnZoomAsync" />
    <span class="cal-zoom-cap" aria-hidden="true">−</span>
</div>
</div>

@code {
    /// <summary>Vertical scale: pixels per hour, driven by the zoom slider.
    /// Everything the grid draws — labels, blocks, markers, the now-line —
    /// derives from this one number, so zooming is just re-rendering with a
    /// different value. The default matches the old fixed 48px scale that the
    /// UI tests' pixel maths assume, so every suite still opens on the layout
    /// it knows.</summary>
    private double HourPx = DefaultHourPx;

    private const double DefaultHourPx = 48;
    private const double MinHourPx = 32;
    private const double MaxHourPx = 128;

    /// <summary>Readability floor for a rendered block: enough for one line of
    /// the 0.72rem block label. Anything shorter is inflated, so pixel maths
    /// over small blocks overstates their real duration.</summary>
    private const double MinBlockPx = 20;

    /// <summary>Height at which a block can show a second line of text. Below
    /// it the title never renders — the clamp pushes it onto a line the box is
    /// too short to reveal — so short blocks put the time and title on one line
    /// and ellipsise instead. One line of 0.75rem at line-height 1.25 plus the
    /// block's vertical padding is ~18px, so two need ~34.</summary>
    private const double TwoLinePx = 34;

    /// <summary>One rendered text line: 0.75rem at line-height 1.25.</summary>
    private const double LinePx = 15;

    /// <summary>The block's vertical padding (0.1rem top and bottom).</summary>
    private const double BlockPadPx = 4;
    private static readonly TimeSpan PlanHorizon = TimeSpan.FromDays(14);

    // The visible span: viewStart plus dayCount columns. Week view anchors to
    // Monday; day and 3-day views anchor to whatever day the user is on, so
    // "Today" means "first column is today" there rather than "this week".
    private DateTime viewStart;
    private int dayCount = 7;

    private ElementReference scrollArea;
    private readonly PeriodicTimer clock = new(TimeSpan.FromSeconds(60));

    private static DateTime Today => DateTime.Today;

    private double NowOffsetPx => DateTime.Now.TimeOfDay.TotalHours * HourPx;

    private bool IsOnToday => dayCount == 7
        ? viewStart == StartOfWeek(Today)
        : viewStart == Today;

    /// <summary>Whether today's column is in the visible span — the gutter's
    /// now-label follows this, not <see cref="IsOnToday"/>: a 3-day view that
    /// started yesterday still shows today and deserves the marker.</summary>
    private bool TodayVisible => Today >= viewStart && Today < viewStart.AddDays(dayCount);

    // Week view keeps the exact labels the UI suites click; the narrower views
    // shift by their own span, so "week" would be wrong there.
    private string PrevLabel => dayCount == 7 ? "‹ Previous week" : "‹ Previous";

    private string NextLabel => dayCount == 7 ? "Next week ›" : "Next ›";

    private string WeekRangeText => dayCount == 1
        ? $"{viewStart:ddd d MMM yyyy}"
        : $"{viewStart:d MMM} – {viewStart.AddDays(dayCount - 1):d MMM yyyy}";

    /// <summary>A rendered column entry. <paramref name="Lane"/> and
    /// <paramref name="LaneCount"/> come from <see cref="AssignLanes"/>; blocked
    /// shading keeps the default single full-width lane.</summary>
    private sealed record Block(
        double Top, double Height, string Css, string TimeText, string Title, string Tooltip,
        bool Late = false, int Lane = 0, int LaneCount = 1)
    {
        /// <summary>Side-by-side split. Mirrors the 3px inset `.cal-block`
        /// applies, minus a 2px gutter so neighbouring lanes stay readable.
        /// `left` + `width` over-constrain the box, so the CSS `right` is
        /// dropped by the layout engine — which is what we want here.</summary>
        public string LaneStyle => LaneCount <= 1
            ? string.Empty
            : $"left:calc(3px + (100% - 6px) * {Lane} / {LaneCount});" +
              $"width:calc((100% - 6px) / {LaneCount} - 2px);";

        /// <summary>True when the block is too short for a second line of text.
        /// Drives the one-line, ellipsised rendering — the alternative is a
        /// title clipped out of view entirely, which is what short blocks did.</summary>
        public bool Compact => Height < TwoLinePx;

        /// <summary>How many whole lines the title may wrap to: the lines that
        /// fit under the head row, never fewer than one. Computed here rather
        /// than left to CSS line-clamping against the box, which is what used
        /// to truncate titles unpredictably — a clamp sized to the space that
        /// actually exists is deterministic. This is what makes the zoom
        /// slider pay off: taller blocks turn their extra height into visible
        /// text instead of padding.</summary>
        public int TitleLines => Math.Max(1, (int)((Height - BlockPadPx - LinePx) / LinePx));

        /// <summary>The block's full class list. Built here rather than inline in
        /// the markup: Razor cannot parse a quoted string inside an attribute
        /// that is itself quoted.</summary>
        public string CssClass => Compact ? $"{Css} compact" : Css;
    }
    private sealed record Marker(double Top, string Title, string Tooltip);
    private sealed record DayView(DateTime Date, bool IsToday, bool IsWeekend, List<Block> Blocks, List<Marker> Markers);
    private sealed record WeekView(List<DayView> Days, bool Empty);

    protected override async Task OnInitializedAsync()
    {
        viewStart = StartOfWeek(Today);
        await Todos.LoadAsync();
        Todos.Changed += OnDataChanged;
        _ = TickAsync();
    }

    private void OnDataChanged() => _ = InvokeAsync(StateHasChanged);

    // Accumulates zoom changes made since the last render, so the scroll
    // correction runs after the grid has actually been re-laid-out at the new
    // scale — correcting before the render would measure the old heights.
    private double? pendingZoomFactor;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Drop the viewport at 07:00 so the working day is in view.
            await JS.InvokeVoidAsync("taskDashboard.scrollTo", scrollArea, 7 * HourPx);
        }

        if (pendingZoomFactor is { } factor)
        {
            pendingZoomFactor = null;
            await JS.InvokeVoidAsync("taskDashboard.scaleScroll", scrollArea, factor);
        }
    }

    /// <summary>Applies the slider. The moment at the viewport's centre stays
    /// at the centre — zooming stretches the grid around what the user is
    /// looking at instead of teleporting them to a different hour.</summary>
    private Task OnZoomAsync(ChangeEventArgs e)
    {
        if (!double.TryParse(e.Value?.ToString(), out var px))
        {
            return Task.CompletedTask;
        }

        px = Math.Clamp(px, MinHourPx, MaxHourPx);
        if (px == HourPx)
        {
            return Task.CompletedTask;
        }

        pendingZoomFactor = (pendingZoomFactor ?? 1) * (px / HourPx);
        HourPx = px;
        return Task.CompletedTask;
    }

    private async Task TickAsync()
    {
        try
        {
            while (await clock.WaitForNextTickAsync())
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed.
        }
    }

    public void Dispose()
    {
        Todos.Changed -= OnDataChanged;
        clock.Dispose();
    }

    private static DateTime StartOfWeek(DateTime date)
    {
        var diff = ((int)date.DayOfWeek - (int)DayOfWeek.Monday + 7) % 7;
        return date.AddDays(-diff);
    }

    private void Shift(int direction) => viewStart = viewStart.AddDays(direction * dayCount);

    private void GoToday() => viewStart = dayCount == 7 ? StartOfWeek(Today) : Today;

    /// <summary>Switches between day, 3-day and week views. Whatever was on
    /// screen stays reachable: growing to the week snaps to the Monday of the
    /// span being viewed; narrowing anchors on today when it is in the current
    /// span, else on the span's first day.</summary>
    private void SetView(int days)
    {
        if (days == dayCount)
        {
            return;
        }

        var todayVisible = Today >= viewStart && Today < viewStart.AddDays(dayCount);
        dayCount = days;
        viewStart = days == 7
            ? StartOfWeek(viewStart)
            : todayVisible ? Today : viewStart;
    }

    /// <summary>Computes the whole visible span in one pass: one planner run,
    /// then per-day clipping.</summary>
    private WeekView BuildWeek()
    {
        var now = DateTimeOffset.Now;
        var busy = BlockedTime.Expand(Todos.BlockedPeriods, now, now + PlanHorizon);
        var plan = Planner.Plan(Todos.Items, busy, now, PlanHorizon, Todos.BreakBetweenTasks);

        var days = new List<DayView>(dayCount);
        for (var d = 0; d < dayCount; d++)
        {
            var date = viewStart.AddDays(d);
            days.Add(new DayView(
                date,
                date == Today,
                date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday,
                BlocksFor(date, plan),
                DeadlinesFor(date)));
        }

        var empty = days.All(day => day.Blocks.Count == 0 && day.Markers.Count == 0);
        return new WeekView(days, empty);
    }

    private List<Block> BlocksFor(DateTime day, List<PlannedSlot> plan)
    {
        var dayStart = new DateTimeOffset(day, DateTimeOffset.Now.Offset);
        var dayEnd = dayStart.AddDays(1);
        var blocks = new List<Block>();

        // Foreground entries — planned slots and completed work — share the
        // column and get split into lanes below. Blocked shading stays behind
        // them at full width, so it is deliberately not laid out.
        var laid = new List<Block>();

        // Blocked time shades the background of the column.
        foreach (var (period, range) in BlockedTime.ExpandDetailed(Todos.BlockedPeriods, dayStart, dayEnd))
        {
            var (top, height) = Clip(range.Start, range.End, dayStart, dayEnd);
            blocks.Add(new Block(
                top, height, "cal-block cal-blocked",
                range.Start.ToLocalTime().ToString("HH:mm"),
                period.Label,
                $"Blocked: {period.Label}"));
        }

        // Planned slots for unfinished work, routed around blocked time.
        foreach (var slot in plan)
        {
            if (slot.End <= dayStart || slot.Start >= dayEnd)
            {
                continue;
            }

            var task = Todos.Items.FirstOrDefault(t => t.Id == slot.TaskId);
            if (task is null)
            {
                continue;
            }

            var (top, height) = Clip(slot.Start, slot.End, dayStart, dayEnd);
            var css = $"cal-block cal-slot cal-p-{task.Priority.ToString().ToLowerInvariant()}{(slot.MissesDeadline ? " missed" : "")}{(task.IsInProgress ? " started" : "")}";
            var tooltip = slot.MissesDeadline
                ? $"{task.Title} — planned {slot.Start.ToLocalTime():HH:mm}–{slot.End.ToLocalTime():HH:mm}, finishes after its deadline"
                : $"{task.Title} — planned {slot.Start.ToLocalTime():HH:mm}–{slot.End.ToLocalTime():HH:mm}";
            if (task.IsInProgress)
            {
                tooltip += " (in progress)";
            }

            laid.Add(new Block(
                top, height, css, slot.Start.ToLocalTime().ToString("HH:mm"), task.Title, tooltip,
                Late: slot.MissesDeadline));
        }

        // What was actually done. When the task was started, [StartedAt,
        // CompletedAt] is the real span; otherwise fall back to painting the
        // estimate backwards from completion.
        foreach (var task in Todos.Items.Where(t => t.IsDone && t.CompletedAt is not null))
        {
            var end = task.CompletedAt!.Value.ToLocalTime();
            var start = task.StartedAt is { } begun && begun < task.CompletedAt
                ? begun.ToLocalTime()
                : end - (task.EstimatedTime ?? Planner.DefaultEstimate);
            if (end <= dayStart || start >= dayEnd)
            {
                continue;
            }

            var (top, height) = Clip(start, end, dayStart, dayEnd);
            laid.Add(new Block(
                top, height, "cal-block cal-done",
                end.ToString("HH:mm"),
                $"✓ {task.Title}",
                $"{task.Title} — completed {end:HH:mm}"));
        }

        blocks.AddRange(AssignLanes(laid));
        return blocks;
    }

    /// <summary>Standard day-calendar column split. Walks blocks in start order,
    /// building maximal clusters of mutually overlapping entries; within a
    /// cluster each block takes the first lane that has already ended, and every
    /// member is stamped with the cluster's final lane count so the CSS widths
    /// agree. Heights are the post-<see cref="Clip"/> clamped ones on purpose:
    /// two short tasks that only overlap because of the readability clamp still
    /// visually collide, so they should still be split.</summary>
    private static List<Block> AssignLanes(List<Block> blocks)
    {
        if (blocks.Count < 2)
        {
            return blocks;
        }

        var ordered = blocks.OrderBy(b => b.Top).ThenByDescending(b => b.Height).ToList();
        var result = new List<Block>(ordered.Count);
        var cluster = new List<Block>();
        var laneOf = new List<int>();
        var laneEnds = new List<double>();
        var clusterEnd = double.NegativeInfinity;

        void Flush()
        {
            for (var i = 0; i < cluster.Count; i++)
            {
                result.Add(cluster[i] with { Lane = laneOf[i], LaneCount = laneEnds.Count });
            }

            cluster.Clear();
            laneOf.Clear();
            laneEnds.Clear();
            clusterEnd = double.NegativeInfinity;
        }

        foreach (var block in ordered)
        {
            if (block.Top >= clusterEnd)
            {
                Flush();
            }

            var lane = laneEnds.FindIndex(end => end <= block.Top);
            if (lane < 0)
            {
                laneEnds.Add(block.Top + block.Height);
                lane = laneEnds.Count - 1;
            }
            else
            {
                laneEnds[lane] = block.Top + block.Height;
            }

            cluster.Add(block);
            laneOf.Add(lane);
            clusterEnd = Math.Max(clusterEnd, block.Top + block.Height);
        }

        Flush();
        return result;
    }

    private List<Marker> DeadlinesFor(DateTime day)
    {
        var dayStart = new DateTimeOffset(day, DateTimeOffset.Now.Offset);
        var dayEnd = dayStart.AddDays(1);
        var markers = new List<Marker>();

        foreach (var task in Todos.Items.Where(t => !t.IsDone && t.Deadline is not null))
        {
            var deadline = task.Deadline!.Value.ToLocalTime();
            if (deadline < dayStart || deadline >= dayEnd)
            {
                continue;
            }

            var top = (deadline - dayStart).TotalHours * HourPx;
            markers.Add(new Marker(top, $"⚑ {task.Title}", $"Deadline: {task.Title}, {deadline:HH:mm}"));
        }

        return markers;
    }

    private (double Top, double Height) Clip(
        DateTimeOffset start, DateTimeOffset end, DateTimeOffset dayStart, DateTimeOffset dayEnd)
    {
        var visibleStart = start < dayStart ? dayStart : start;
        var visibleEnd = end > dayEnd ? dayEnd : end;
        var top = (visibleStart - dayStart).TotalHours * HourPx;
        // 14px cut the descenders off a single 0.72rem line, so a 15-minute
        // task showed a clipped label. Raising the floor to MinBlockPx fits one
        // line; tools/UiTest's overlap filter is pinned to this constant.
        var height = Math.Max((visibleEnd - visibleStart).TotalHours * HourPx, MinBlockPx);
        return (top, height);
    }
}
